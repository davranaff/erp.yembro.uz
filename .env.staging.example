COMPOSE_PROJECT_NAME=yembro-staging

# ── Django backend ───────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=staging.erp.yembro.uz,staging.api.erp.yembro.uz,staging-api,localhost,127.0.0.1
APP_ENVIRONMENT=staging

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=yembro_staging
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yembro_staging
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me
CELERY_BROKER_URL=redis://:change-me@redis:6379/0
CELERY_RESULT_BACKEND=django-db

# ── CORS / public URLs ───────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://staging.erp.yembro.uz
PUBLIC_WEB_BASE_URL=https://staging.erp.yembro.uz

# ── Storage ──────────────────────────────────────────────────────────────────
APP_STORAGE_LOCAL_ROOT=/data/uploads

# ── Deployment images (overwritten by .release.env on deploy) ────────────────
BACKEND_IMAGE=registry.example.com/yembro/backend:staging
FRONTEND_IMAGE=registry.example.com/yembro/frontend:staging

# ── Docker volumes and networks ──────────────────────────────────────────────
POSTGRES_VOLUME_NAME=postgres_data_staging
REDIS_VOLUME_NAME=redis_data_staging
UPLOADS_VOLUME_NAME=uploads_staging
INTERNAL_NETWORK_NAME=yembro_staging_internal
PUBLIC_NETWORK_NAME=yembro_staging_public

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_ROOT=/opt/yembro/backups/staging

# ── Catalog (staging.yembro.uz публичный сайт) ──────────────────────────────
# CATALOG_* перезаписываются CI/CD через .release.env, но дублируем здесь
# как fallback (если развёртываете руками).
CATALOG_IMAGE=registry.example.com/yembro/catalog:staging
CATALOG_NEXT_PUBLIC_API_URL=https://staging.api.erp.yembro.uz/api/catalog/v1
CATALOG_API_URL_INTERNAL=http://staging-api:30000/api/catalog/v1
CATALOG_NEXT_PUBLIC_SITE_URL=https://staging.yembro.uz
CATALOG_NEXT_PUBLIC_ERP_URL=https://staging.erp.yembro.uz
CATALOG_REVALIDATE_SECRET=change-me
CATALOG_FRONTEND_URL=http://staging-catalog:3001
CATALOG_NOTIFY_CHAT_IDS=
CATALOG_YM_ID=
CATALOG_GA_ID=
STATICFILES_VOLUME_NAME=staticfiles_staging

# ── OTP / SMS (Eskiz notify.eskiz.uz) ───────────────────────────────────────
# Креды кабинета Eskiz. Без них /api/otp/request/ → 503.
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Sender ID. По умолчанию тестовый 4546 — работает только с текстом
# "Bu Eskiz dan test". Чтобы слать осмысленные коды, получите свой alpha-name
# (Eskiz LK → «СМС → Заявка на ник»), и тогда заработает OTP_MESSAGE_TEMPLATE.
ESKIZ_FROM=4546
ESKIZ_TIMEOUT_SECONDS=10
# Webhook URL для статусов доставки. Содержит shared secret в пути.
# В production: https://<host>/api/sms/callback/<secret>/
ESKIZ_CALLBACK_URL=
ESKIZ_CALLBACK_SECRET=
# Порог TG-алерта по балансу (UZS). 50 000 ≈ 165 SMS по 300 UZS.
ESKIZ_BALANCE_ALERT_THRESHOLD_UZS=50000

# OTP параметры
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_INTERVAL_SECONDS=60
# {code} подставляется в текст. Должен быть согласован с Eskiz.
OTP_MESSAGE_TEMPLATE="Bu Eskiz dan test"
# В проде ВСЕГДА false. true разрешает клиенту слать произвольный текст
# (превращает endpoint в spam-шлюз).
OTP_ALLOW_CLIENT_TEMPLATE=false
# true — пишем код в лог вместо SMS. Для local dev.
OTP_DEV_PRINT=false
