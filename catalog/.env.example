# Публичный URL бэкенда — попадает в браузер (client components).
NEXT_PUBLIC_API_URL=https://api.yembro.uz/api/catalog/v1

# Внутренний URL бэкенда — используется для server-side fetch (RSC, sitemap).
# В docker — имя сервиса в сети (http://api:30000/api/catalog/v1).
CATALOG_API_URL_INTERNAL=http://api:30000/api/catalog/v1

# Канонический origin сайта (для canonical, OG, sitemap).
NEXT_PUBLIC_SITE_URL=https://yembro.uz

# URL ERP-приложения для CTA "Арендовать ERP".
NEXT_PUBLIC_ERP_URL=https://erp.yembro.uz

# Yandex.Metrica counter id.
NEXT_PUBLIC_YM_ID=

# Google Analytics 4 measurement id (G-XXXXXXX).
NEXT_PUBLIC_GA_ID=

# Совпадает с CATALOG_REVALIDATE_SECRET в backend/.env.
# Используется для аутентификации входящих /api/revalidate POST'ов.
REVALIDATE_SECRET=change-me
